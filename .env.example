# 复制为 .env 后按环境填写。密钥不要提交进仓库。

# 固定为正式域名：canonical、站点地图、结构化数据都用它
NUXT_PUBLIC_SITE_URL=https://uswoo.com
# 浏览器端接口基址（所有环境相同）
NUXT_PUBLIC_API_BASE=https://uswoo.com/api/uswoo/public
# 服务端渲染用的接口基址；测试站与正式站填 Vectra 后端的内网地址，本地开发留空（回退到上面的公开地址）
NUXT_API_BASE_SERVER=
# 服务端直连内网时需要带上的 Host 头；本地开发留空
NUXT_API_HOST_HEADER=
# staging = 测试站（全站禁止收录、表单标记为测试来源）；production = 正式站
NUXT_PUBLIC_DEPLOY_ENV=staging
# 校验 Vectra 缓存刷新通知的签名
NUXT_REVALIDATE_SECRET=
